{
  "name": "agent-discussion-room",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "audit": "bun run scripts/dependency-audit.ts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run audit && bun run build",
    "verify:full": "bun run verify && bun run test:browser",
    "test:sandcastle": "bun test ./.sandcastle/tests/*.test.ts",
    "sandcastle:build": "bun .sandcastle/build-image.ts",
    "sandcastle:plan": "bun .sandcastle/main.ts --dry-run",
    "sandcastle:run": "bun .sandcastle/main.ts",
    "sandcastle:resume": "bun .sandcastle/main.ts --resume"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.57.0",
    "@mastra/libsql": "^1.19.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/observability": "^1.16.5",
    "mastra": "^1.23.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "1.3.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "compression": "1.8.2"
  }
}
