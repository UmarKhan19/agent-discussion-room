{
  "name": "agent-discussion-room",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sandcastle": "bun test ./.sandcastle/tests/*.test.ts",
    "sandcastle:build": "bun .sandcastle/build-image.ts",
    "sandcastle:plan": "bun .sandcastle/main.ts --dry-run",
    "sandcastle:run": "bun .sandcastle/main.ts",
    "sandcastle:resume": "bun .sandcastle/main.ts --resume"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.55.0",
    "@mastra/duckdb": "^1.5.2",
    "@mastra/libsql": "^1.18.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/observability": "^1.16.3",
    "mastra": "^1.21.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
