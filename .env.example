# ---------------------------------------------------------------------------
# Agent Discussion Room — environment contract
#
# Production startup fails with a clear, non-secret error when any required
# value below is absent or invalid. Development and test runs work without
# them and use explicit in-memory configuration instead.
# ---------------------------------------------------------------------------

# Provider credential used by the Supporter and Opponent agents (required in
# production; the agents are configured with the opencode provider).
OPENCODE_API_KEY=your-api-key

# Session-signing secret (required in production, at least 32 characters).
# A stable secret lets signed session ownership survive restarts; without it,
# every process restart invalidates participant sessions.
DISCUSSION_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Durable libSQL storage URL (required in production; optional in development
# and test, where the explicit default is in-memory storage).
#
# Supported forms:
#   file:/absolute/path/to/discussions.db   local file (single-instance deployments)
#   file:./discussions.db                   local file relative to the working directory
#   libsql://your-db.turso.io               managed remote libSQL database
#   https://your-db.example.com             remote libSQL HTTP endpoint
#
# The same URL backs the Discussion system of record (ownership, Topic,
# ordered Messages, status, Turn counts, timestamps, policy outcomes, and
# request identities). Local file URLs use a sibling <directory>/mastra.db
# for the central Mastra runtime storage so the two never contend on one
# SQLite file; remote URLs are shared.
DISCUSSION_STORE_URL=file:./data/discussions.db

# Authentication token for remote libSQL databases (optional; ignored for
# local file URLs).
DISCUSSION_STORE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Deterministic browser-test mode (development/test only; rejected in
# production, where startup fails loudly instead).
# ---------------------------------------------------------------------------
# Runs the Room with a scripted, credential-free generation adapter so the
# Playwright suite needs no provider credentials and makes no network model
# calls. Scripted behavior (success, delay, transient failure, policy
# violation, abort-ignoring providers) is configured per test through
# POST /api/test-harness/scenario, which 404s unless this mode is active.
# See docs/browser-tests.md.
#
# Keep this commented out in any long-lived .env.local: uncommenting it
# switches development Turn generation to scripted output (no provider).
# DISCUSSION_GENERATION_MODE=deterministic

# ---------------------------------------------------------------------------
# Discussion Room endpoint protection (all optional, safe defaults shown;
# invalid or non-positive values fall back to the default).
# ---------------------------------------------------------------------------
# Maximum JSON request body size in bytes.
DISCUSSION_MAX_REQUEST_BODY_BYTES=4096
# Maximum requests one signed session may send per window, and window length in ms.
DISCUSSION_SESSION_RATE_LIMIT=60
DISCUSSION_SESSION_RATE_WINDOW_MS=60000
# Maximum requests one client network address may send per window, and window length in ms.
DISCUSSION_NETWORK_RATE_LIMIT=300
DISCUSSION_NETWORK_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Discussion generation budgets (all optional, safe defaults shown;
# non-numeric or out-of-range values fail startup loudly, and values above
# the server hard maximum are rejected).
# ---------------------------------------------------------------------------
# Maximum number of Turns per Discussion (server hard maximum is 12).
DISCUSSION_TURN_LIMIT=12
# Most-recent completed Turns retained in model context (hard maximum 32).
DISCUSSION_RECENT_TRANSCRIPT_TURNS=8
# Character ceiling for the recent-Transcript context (hard maximum 64000).
DISCUSSION_TRANSCRIPT_CHARACTER_BUDGET=32000
# Character ceiling for the Transcript provided as synthesis context (hard maximum 64000; normally the whole debate fits).
DISCUSSION_SYNTHESIS_TRANSCRIPT_CHARACTER_BUDGET=48000
# Output-token ceiling passed to the provider (hard maximum 8000).
DISCUSSION_MAX_OUTPUT_TOKENS=2000
# Output-character ceiling enforced after generation (hard maximum 12000).
DISCUSSION_MAX_OUTPUT_CHARACTERS=8000
# Hard generation duration ceiling in milliseconds (hard maximum 300000).
DISCUSSION_GENERATION_TIMEOUT_MS=30000
# Simultaneous model generations across all Discussions in this process (hard maximum 16).
DISCUSSION_MAX_CONCURRENT_GENERATIONS=4
# Model-generating next-Turn requests one signed session may claim per time window (hard maximum 10000).
DISCUSSION_SESSION_GENERATION_QUOTA=500
# Time window in milliseconds over which the session generation quota is measured (default 86400000 = 24h; hard maximum 2592000000 = 30 days, matching the session cookie Max-Age).
DISCUSSION_SESSION_GENERATION_QUOTA_WINDOW_MS=86400000

# ---------------------------------------------------------------------------
# Operational telemetry (privacy-safe by construction; see
# docs/observability-privacy.md).
# ---------------------------------------------------------------------------
# JSON-lines telemetry is always written to stdout. Conversation content is
# structurally impossible to record. External export is OFF unless enabled.
DISCUSSION_OBSERVABILITY_EXPORT_ENABLED=false
# Required when export is enabled in production: Mastra platform access token
# used by the platform span exporter (self-disables without it).
MASTRA_PLATFORM_ACCESS_TOKEN=
